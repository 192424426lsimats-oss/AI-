from collections import deque

class State:
    def __init__(self, missionaries, cannibals, boat, parent=None):
        self.m = missionaries
        self.c = cannibals
        self.boat = boat  # 1 = left bank, 0 = right bank
        self.parent = parent

    def is_valid(self):
        if self.m < 0 or self.c < 0 or self.m > 3 or self.c > 3:
            return False
        if (self.m < self.c and self.m > 0) or (3 - self.m < 3 - self.c and 3 - self.m > 0):
            return False
        return True

    def is_goal(self):
        return self.m == 0 and self.c == 0 and self.boat == 0

    def __eq__(self, other):
        return self.m == other.m and self.c == other.c and self.boat == other.boat

    def __hash__(self):
        return hash((self.m, self.c, self.boat))

def successors(state):
    moves = [(1,0),(2,0),(0,1),(0,2),(1,1)]
    result = []
    for m, c in moves:
        if state.boat == 1:  # boat on left
            new_state = State(state.m - m, state.c - c, 0, state)
        else:  # boat on right
            new_state = State(state.m + m, state.c + c, 1, state)
        if new_state.is_valid():
            result.append(new_state)
    return result

def solve():
    start = State(3,3,1)
    frontier = deque([start])
    explored = set()

    while frontier:
        state = frontier.popleft()
        if state.is_goal():
            path = []
            while state:
                path.append((state.m, state.c, state.boat))
                state = state.parent
            return path[::-1]
        explored.add(state)
        for s in successors(state):
            if s not in explored:
                frontier.append(s)
    return None

solution = solve()
print("Solution path:")
for step in solution:
    print(step)
