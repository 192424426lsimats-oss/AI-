import random

def vacuum_cleaner():
    # Environment: two rooms A and B
    rooms = {"A": random.choice(["Clean", "Dirty"]),
             "B": random.choice(["Clean", "Dirty"])}
    location = random.choice(["A", "B"])

    print("Initial state:", rooms, "Vacuum at", location)

    steps = 0
    while "Dirty" in rooms.values():
        if rooms[location] == "Dirty":
            print(f"Room {location} is dirty. Cleaning...")
            rooms[location] = "Clean"
        else:
            location = "A" if location == "B" else "B"
            print(f"Moving to room {location}")
        steps += 1

    print("Final state:", rooms, f"Cleaned in {steps} steps")

vacuum_cleaner()
